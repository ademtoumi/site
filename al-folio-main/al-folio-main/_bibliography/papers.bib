@mastersthesis{toumi2026survey,
  author    = {Toumi, Adem},
  title     = {A Survey on Log-Based Anomaly Detection in Distributed Systems: Methods, Benchmarks, and Explainability},
  school    = {Higher School of Computer Science (ESI-SBA)},
  year      = {2026},
  month     = {July},
  type      = {Master's Thesis},
  note      = {Supervisors: Dr. Sidi Mohammed Benslimane (ESI-SBA), Dr. Mohammed Bekkouche (GRESCOM). Jury President: Dr. KHALDI Miloud},
  abstract  = {Systematic literature survey and comparative synthesis of log-based anomaly detection methods for distributed systems. Covers session construction strategies, classical ML (SVM, DT, RF), unsupervised DL (LSTM-AE, BiLSTM-AE, Dense-AE, DeepLog), supervised DL (Attention-BiLSTM, CNN+BiLSTM), and Transformer-based models (LogBERT) across HDFS, BGL, and Spirit benchmarks. Includes SHAP and LIME post-hoc explainability and a real-time streaming demonstration pipeline.},
  pdf       = {https://github.com/ademtoumi/log-anomaly-detection/blob/main/Master_Thesis.pdf},
  bibtex_show = {true},
  selected  = {true}
}

@thesis{toumi2025pfe,
  author    = {Toumi, Adem},
  title     = {Explainable AI for Log Anomaly Detection in Distributed Systems},
  school    = {Higher School of Computer Science (ESI-SBA)},
